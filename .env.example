# ==========================================
# Groq API Configuration for Rajeshwari's AI Chatbot
# ==========================================
# Obtain your free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Active high-intelligence Groq models:
# - openai/gpt-oss-120b (Broad knowledge, deep reasoning)
# - qwen/qwen3.8-27b (Fast & versatile)
GROQ_MODEL=openai/gpt-oss-120b
PORT=3000
